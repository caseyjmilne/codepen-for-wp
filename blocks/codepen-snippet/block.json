{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codepen-for-wp/snippet",
	"title": "CodePen Snippet",
	"category": "embed",
	"icon": "editor-code",
	"description": "Write HTML, CSS and JS in a code editor and display it as a live, interactive CodePen embed.",
	"keywords": [ "codepen", "code", "embed", "snippet" ],
	"textdomain": "codepen-for-wp",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"html": {
			"type": "string",
			"default": ""
		},
		"css": {
			"type": "string",
			"default": ""
		},
		"js": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": "inherit"
		},
		"height": {
			"type": "number",
			"default": 0
		},
		"defaultTab": {
			"type": "string",
			"default": "inherit"
		},
		"editable": {
			"type": "string",
			"default": "inherit"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "cpfwp-block-editor",
	"editorStyle": "cpfwp-block-editor-style",
	"render": "file:./render.php"
}
